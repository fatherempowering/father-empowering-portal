{
  "name": "father-empowering",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @father-empowering/portal",
    "build": "npm run build --workspace @father-empowering/portal",
    "lint": "npm run lint --workspace @father-empowering/portal",
    "typecheck": "npm run typecheck --workspace @father-empowering/portal",
    "test": "npm run test --workspace @father-empowering/portal",
    "test:unit": "npm run test:unit --workspace @father-empowering/portal",
    "test:integration": "npm run test:integration --workspace @father-empowering/portal",
    "test:sql": "npm run test:sql --workspace @father-empowering/portal",
    "test:e2e": "npm run test:e2e --workspace @father-empowering/portal",
    "test:m1": "npm run test:m1 --workspace @father-empowering/portal"
  }
}
