  "sections": [
    {
      "title": "Personal Information",
      "intro": "Welcome to Week Zero.  This intake allows Max to build your personalized Legacy Protocol.  Be honest. Be accurate. Do not try to impress.  The goal is not perfection. The goal is precision.",
