# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 32+ random characters, server-only. Derives retry-stable opaque invitation
# tokens without persisting the raw token.
INVITATION_TOKEN_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=re_your_key
INVITATION_EMAIL_FROM=Father Empowering <portal@fatherempowering.com>
OUTBOX_WORKER_SECRET=replace-with-an-independent-32-character-secret

# Canonical URL used in invitation and OTP redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed/bootstrap value used only by an explicit administrative setup command.
FATHER_EMPOWERING_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
